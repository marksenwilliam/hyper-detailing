---
// Contact & booking: every "Boka tid" button on the page lands here.
//
// Left column: the direct channels (call, SMS, e-mail, map, hours). Right
// column: the booking request form. On submit the script POSTs the fields as
// JSON to /api/lead (src/pages/api/lead.ts), a server route that creates the
// contact in the client's GoHighLevel sub-account — the API token stays on
// the server. The only third-party request the browser makes is Cloudflare
// Turnstile, the bot check sitting in front of the submit button.
//
// GDPR: the privacy policy (linked under the form) names the CRM as a
// recipient and explains the transfer basis (art. 13 information duty).
import { site, fullAddress } from "../data/site";
import { PUBLIC_TURNSTILE_SITEKEY } from "astro:env/client";

const endpoint = "/api/lead";

// Empty until the sitekey is in the environment, and the widget and its script
// then stay out of the page entirely. /api/lead tolerates that only in local
// development: a production build rejects every submission that lacks a
// verified token, so a deployment needs both the sitekey and the secret.
const turnstileSitekey = PUBLIC_TURNSTILE_SITEKEY ?? "";
---

<section class="contact" id="kontakt" aria-labelledby="contact-title">
  <div class="container">
    <header class="contact-head" data-animate="fade-up">
      <span class="section-label">Kontakt &amp; bokning</span>
      <div class="contact-head-row">
        <h2 class="section-heading" id="contact-title">
          Boka <span class="accent">din tid</span>
        </h2>
        <p class="contact-head-sub">
          Ring, sms:a, mejla eller skicka en bokningsförfrågan – vi återkommer
          snabbt och bekräftar tiden med dig. Vi arbetar enbart med bokade tider.
        </p>
      </div>
    </header>

    <div class="contact-grid">
      <!-- ---------- Direct channels ---------- -->
      <div class="contact-card" data-animate="fade-up">
        <h3 class="contact-card-title">Snabbast: ring eller sms:a</h3>

        <ul class="contact-list">
          <li>
            <span class="contact-icon" aria-hidden="true">
              <img src="/assets/icons/icon-phone.svg" alt="" width="20" height="20" />
            </span>
            <span class="contact-body">
              <span class="contact-label">Telefon</span>
              <a class="contact-value contact-value--big" href={site.phoneHref}>{site.phone}</a>
              <span class="contact-hint">Svar direkt under öppettid – lämna ett meddelande om vi står med händerna i skummet.</span>
            </span>
          </li>
          <li>
            <span class="contact-icon" aria-hidden="true">
              <img src="/assets/icons/icon-mail.svg" alt="" width="20" height="20" />
            </span>
            <span class="contact-body">
              <span class="contact-label">E-post</span>
              <a class="contact-value" href={`mailto:${site.email}`}>{site.email}</a>
            </span>
          </li>
          <li>
            <span class="contact-icon" aria-hidden="true">
              <img src="/assets/icons/icon-pin.svg" alt="" width="20" height="20" />
            </span>
            <span class="contact-body">
              <span class="contact-label">Hitta hit</span>
              <a class="contact-value" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">{fullAddress}</a>
              <span class="contact-links">
                <a class="contact-link" href={site.directionsUrl} target="_blank" rel="noopener noreferrer">
                  Vägbeskrivning (GPS)
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M9 7h8v8"></path>
                  </svg>
                </a>
                <a class="contact-link" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
                  Visa på Google Maps
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17L17 7M9 7h8v8"></path>
                  </svg>
                </a>
              </span>
            </span>
          </li>
          <li>
            <span class="contact-icon" aria-hidden="true">
              <img src="/assets/icons/icon-clock.svg" alt="" width="20" height="20" />
            </span>
            <span class="contact-body">
              <span class="contact-label">Öppettider</span>
              {site.hours.map((row) => (
                <span class="contact-value">{row.days}: {row.time}</span>
              ))}
            </span>
          </li>
        </ul>

        <div class="contact-actions">
          <a class="btn btn-primary" href={site.phoneHref}>Ring nu</a>
          <a class="btn btn-ghost" href={site.smsHref}>Skicka sms</a>
        </div>
      </div>

      <!-- ---------- Booking request form ---------- -->
      <!-- The action is the same-origin API route, so the form is https in
           production and Chrome's "form is not secure" warning never fires.
           The script intercepts the submit; without JavaScript the browser
           POSTs the same fields to the route directly. -->
      <form
        class="contact-form"
        id="booking-form"
        method="post"
        action={endpoint}
        novalidate
        data-animate="fade-up"
        data-endpoint={endpoint}
        data-phone={site.phoneHref}
        data-email={site.email}
      >
        <h3 class="contact-card-title">Skicka bokningsförfrågan</h3>

        <div class="form-grid">
          <div class="field">
            <label for="bf-first-name">Förnamn <span class="req" aria-hidden="true">*</span></label>
            <input id="bf-first-name" name="firstName" type="text" autocomplete="given-name" required />
          </div>

          <div class="field">
            <label for="bf-last-name">Efternamn <span class="req" aria-hidden="true">*</span></label>
            <input id="bf-last-name" name="lastName" type="text" autocomplete="family-name" required />
          </div>

          <div class="field">
            <label for="bf-phone">Telefon <span class="req" aria-hidden="true">*</span></label>
            <input id="bf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
          </div>

          <div class="field">
            <label for="bf-email">E-post <span class="req" aria-hidden="true">*</span></label>
            <input id="bf-email" name="email" type="email" autocomplete="email" inputmode="email" required />
          </div>

          <div class="field field--full">
            <label for="bf-reg-nr">Registreringsnummer <span class="req" aria-hidden="true">*</span></label>
            <input
              id="bf-reg-nr"
              name="regNr"
              type="text"
              class="input-reg-nr"
              placeholder="ABC 123"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              maxlength="10"
              required
            />
          </div>

          <div class="field field--full">
            <label for="bf-message">Meddelande</label>
            <textarea id="bf-message" name="message" rows="4" placeholder="Berätta gärna vad du vill ha hjälp med, bilens skick och när det passar dig."></textarea>
          </div>

          <!-- Honeypot: hidden from people, filled by bots. The API drops any
               submission where it has a value. -->
          <div class="field field--hp" aria-hidden="true">
            <label for="bf-website">Webbplats</label>
            <input id="bf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
        </div>

        <p class="form-error" id="bf-error" role="alert" hidden>
          Fyll i alla fält märkta med * så att vi kan nå dig.
        </p>

        {turnstileSitekey && (
          <>
            {/* Cloudflare Turnstile. It lives inside the <form> so the hidden
                `cf-turnstile-response` input it injects is swept up by the
                same collect() that gathers every other field — no special
                case in the submit handler. The managed widget normally
                resolves itself without the visitor touching anything. */}
            <div
              class="cf-turnstile form-turnstile"
              data-sitekey={turnstileSitekey}
              data-action="booking"
              data-language="sv"
              data-theme="dark"
            ></div>
            {/* `data-cookieconsent="ignore"` exempts this from Cookiebot's
                auto-blocking. Without it the consent script rewrites the tag
                and the bot check never loads for anyone who has not answered
                the banner yet — which is every first-time visitor, i.e. the
                ones a spam bot imitates. Turnstile is strictly necessary for
                delivering the form the visitor asked for, sets no cookie, and
                so sits outside the consent categories anyway. */}
            <script
              is:inline
              src="https://challenges.cloudflare.com/turnstile/v0/api.js"
              data-cookieconsent="ignore"
              async
              defer></script>
          </>
        )}

        <div class="form-footer">
          <button class="btn btn-primary form-submit" type="submit">Skicka bokningsförfrågan</button>
          <p class="form-note">
            Uppgifterna skickas krypterat till vårt bokningssystem och används bara för
            att hantera din förfrågan.
            <a href="/integritetspolicy">Läs vår integritetspolicy</a>.
          </p>
        </div>

        <p class="form-status" id="bf-status" role="status" aria-live="polite" hidden></p>

        <noscript>
          <p class="form-status">
            Formuläret fungerar bäst med JavaScript. Du kan också mejla oss på
            <a href={`mailto:${site.email}`}>{site.email}</a> eller ringa
            <a href={site.phoneHref}>{site.phone}</a>.
          </p>
        </noscript>
      </form>
    </div>
  </div>
</section>

<style>
  /* The section surface comes from the global card rule; the root only adds
     the internal padding every content section carries. */
  .contact {
    padding: var(--cell-padding);
  }

  /* ---------- Header ---------- */
  .contact-head {
    display: flex;
    flex-direction: column;
    gap: 1.5em;
    padding: 0 0 var(--spacing-2xl);
  }

  .contact-head .section-label {
    align-self: flex-start;
  }

  .contact-head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3em;
  }

  .section-heading {
    max-width: 36.75em; /* 588px */
  }

  .contact-head-sub {
    max-width: 26.1875em; /* 419px */
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text-body);
  }

  /* ---------- Two columns ---------- */
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 1em;
    align-items: stretch;
  }

  .contact-card,
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5em;
    padding: var(--cell-padding);
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-card);
  }

  .contact-card-title {
    font-size: 1.5em; /* 24px */
    font-weight: 600;
    line-height: 1.333;
    letter-spacing: -0.72px;
    color: var(--color-text-white);
  }

  /* ---------- Channel list ---------- */
  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 1.25em;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.875em;
  }

  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5em; /* 40px */
    height: 2.5em;
    border: 1px solid rgba(254, 74, 0, 0.5);
    border-radius: 50%;
    background-color: rgba(254, 74, 0, 0.12);
  }

  .contact-icon img {
    width: 1.25em;
    height: 1.25em;
  }

  .contact-body {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    min-width: 0;
  }

  .contact-label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-body);
  }

  .contact-value {
    font-size: var(--text-base);
    line-height: 1.4;
    color: var(--color-text-white);
    overflow-wrap: anywhere;
  }

  a.contact-value {
    transition: color var(--transition-base);
  }

  a.contact-value:hover,
  .contact-link:hover {
    color: var(--color-accent);
  }

  .contact-value--big {
    font-size: 1.5em; /* 24px */
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .contact-hint {
    font-size: var(--text-sm);
    line-height: 1.4286;
    color: var(--color-text-body);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em 1.25em;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: 0.25em;
    min-height: 2em;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-white);
    transition: color var(--transition-base);
  }

  .contact-link svg {
    width: 1em;
    height: 1em;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    margin-top: auto;
  }

  /* ---------- Form ---------- */
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1em;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    min-width: 0;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  /* Honeypot: out of the layout and the accessibility tree, but not
     display:none — some bots skip fields that are display:none. */
  .field--hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .field label {
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.4286;
    color: var(--color-text-white);
  }

  .req {
    color: var(--color-accent);
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: 2.75em; /* 44px tap target */
    padding: 0.625em 0.875em;
    font-size: var(--text-base);
    line-height: 1.5;
    color: var(--color-text-white);
    background-color: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-base), background-color var(--transition-base);
  }

  .field textarea {
    resize: vertical;
    min-height: 6em;
  }

  .input-reg-nr {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: rgba(255, 255, 255, 0.35);
    text-transform: none;
    letter-spacing: normal;
  }

  .field input:hover,
  .field textarea:hover {
    border-color: var(--color-border-strong);
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 0;
    border-color: var(--color-accent);
  }

  /* Only flagged after a submit attempt (the .was-validated hook), so an
     untouched form never opens red. */
  .contact-form.was-validated .field input:invalid {
    border-color: #e74a51;
  }

  .form-error {
    font-size: var(--text-sm);
    line-height: 1.4286;
    color: #ff8a8f;
  }

  .form-error[hidden],
  .form-status[hidden] {
    display: none;
  }

  /* Turnstile renders a fixed-size iframe and owns everything inside it; this
     only spaces it off the submit row. It sits between the error line and the
     button, so a visitor who has to solve a challenge meets it before the
     thing they are about to click. */
  .form-turnstile {
    margin-bottom: 1.5em;
  }

  .form-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1em;
  }

  .form-submit {
    min-height: 2.75em;
  }

  .form-submit[disabled] {
    opacity: 0.6;
    cursor: wait;
  }

  .form-note {
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-body);
  }

  .form-note a,
  .form-status a {
    color: var(--color-text-white);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color var(--transition-base);
  }

  .form-note a:hover,
  .form-status a:hover {
    color: var(--color-accent);
  }

  .form-status {
    padding: 0.875em 1em;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-white);
    background-color: rgba(254, 74, 0, 0.1);
    border: 1px solid rgba(254, 74, 0, 0.35);
    border-radius: var(--radius-md);
  }

  .form-status.is-error {
    background-color: rgba(231, 74, 81, 0.12);
    border-color: rgba(231, 74, 81, 0.45);
  }

  /* ---------- Responsive ---------- */
  @media screen and (max-width: 991px) {
    .contact-head-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1em;
    }

    .section-heading,
    .contact-head-sub {
      max-width: none;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 767px) {
    .form-grid {
      grid-template-columns: 1fr;
    }

    .contact-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .contact-actions .btn,
    .form-submit {
      width: 100%;
      min-height: 44px;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("#booking-form");
  const status = document.querySelector<HTMLElement>("#bf-status");
  const error = document.querySelector<HTMLElement>("#bf-error");

  // Turnstile tokens are single-use, so the widget has to be reset after every
  // attempt — a successful one included, or a second booking from the same page
  // would go out carrying a spent token.
  const resetTurnstile = () =>
    (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();

  const setStatus = (html: string, isError = false) => {
    if (!status) return;
    status.innerHTML = html;
    status.classList.toggle("is-error", isError);
    status.hidden = false;
  };

  if (form) {
    const endpoint = form.dataset.endpoint ?? form.action;
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");

    // Every named field → { name: value }; blanks are skipped
    const collect = () => {
      const data: Record<string, string> = {};
      form
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[name], textarea[name]")
        .forEach((field) => {
          const value = field.value.trim();
          if (value) data[field.name] = value;
        });
      return data;
    };

    const fallback = () =>
      `Det gick inte att skicka just nu. <a href="${form.dataset.phone}">Ring oss</a> ` +
      `eller <a href="mailto:${form.dataset.email}">mejla ${form.dataset.email}</a> i stället.`;

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      form.classList.add("was-validated");

      if (!form.checkValidity()) {
        if (error) error.hidden = false;
        form.querySelector<HTMLElement>(":invalid")?.focus();
        return;
      }
      if (error) error.hidden = true;
      if (status) status.hidden = true;

      if (submit) submit.disabled = true;
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(collect()),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (res.ok && body.ok) {
          form.reset();
          form.classList.remove("was-validated");
          setStatus("Tack! Din förfrågan är mottagen – vi hör av oss så snart vi kan för att bekräfta tiden.");
          status?.focus?.();
        } else if (body.error === "invalid_email" || body.error === "invalid_phone" || body.error === "invalid_reg_nr") {
          const labels: Record<string, string> = {
            invalid_email: "e-postadressen",
            invalid_phone: "telefonnumret",
            invalid_reg_nr: "registreringsnumret",
          };
          setStatus(`Kontrollera ${labels[body.error]} och försök igen.`, true);
        } else if (body.error === "bot_check_failed") {
          setStatus(
            "Vi kunde inte bekräfta att du är en människa. Försök igen, eller " +
              `<a href="${form.dataset.phone}">ring oss</a> så bokar vi åt dig.`,
            true,
          );
        } else {
          setStatus(fallback(), true);
        }
      } catch {
        setStatus(fallback(), true);
      } finally {
        resetTurnstile();
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
